import streamlit as st
from groq import Groq
from google import genai

st.set_page_config(page_title="KI-Agent Dashboard", page_icon="🤖", layout="wide")

st.title("🤖 Mein KI-Büroagent")
st.caption("Automatisierte Verarbeitung von Kundenanfragen mit Fallback-System")

with st.sidebar:
    st.header("⚙️ Einstellungen")
    groq_key = st.text_input("Groq API Key (Primär)", type="password")
    gemini_key = st.text_input("Gemini API Key (Backup)", type="password")

st.divider()

col1, col2 = st.columns(2)

with col1:
    st.subheader("📥 Eingabe")
    kunden_anfrage = st.text_area(
        "Füge hier die Kundenanfrage ein:",
        height=200,
        placeholder="z.B. Hallo, ich brauche ein Angebot..."
    )
    start_button = st.button("🚀 Agenten starten", type="primary")

with col2:
    st.subheader("📤 Ergebnis")
    if start_button:
        if not groq_key and not gemini_key:
            st.error("Bitte gib mindestens einen API Key in der Seitenleiste ein.")
        elif kunden_anfrage.strip():
            with st.spinner("KI verfasst Antwort..."):
                prompt = f"Du bist ein professioneller Kundenservice-Assistent. Verfasse eine höfliche und professionelle Antwort auf folgende Anfrage:\n\n{kunden_anfrage}"
                antwort = None

                # 1. Versuch: Groq (Llama 3)
                if groq_key:
                    try:
                        client_groq = Groq(api_key=groq_key)
                        chat_completion = client_groq.chat.completions.create(
                            messages=[{"role": "user", "content": prompt}],
                            model="llama-3.3-70b-versatile",
                        )
                        antwort = chat_completion.choices[0].message.content
                        st.success("Erfolgreich generiert mit Groq (Llama 3)⚡")
                    except Exception as e:
                        st.warning("Groq war nicht erreichbar, schalte auf Gemini um...")

                # 2. Versuch: Gemini (Fallback)
                if antwort is None and gemini_key:
                    try:
                        client_gemini = genai.Client(api_key=gemini_key)
                        response = client_gemini.models.generate_content(
                            model='gemini-2.5-flash',
                            contents=prompt,
                        )
                        antwort = response.text
                        st.success("Erfolgreich generiert mit Google Gemini ♊")
                    except Exception as e:
                        st.error(f"Fehler bei Gemini: {e}")

                # Ergebnis anzeigen
                if antwort:
                    st.write("**Entwurf der Antwort:**")
                    st.info(antwort)
                elif groq_key or gemini_key:
                    st.error("Keine KI konnte die Anfrage verarbeiten. Bitte überprüfe deine Keys.")
        else:
            st.warning("Bitte gib zuerst einen Text ein.")
